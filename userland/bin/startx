#!/bin/sh
# TinyX needs framebuffer/VT access; installed desktop clients still run as the user.
set -eu
if [ "$(id -u)" -ne 0 ]; then exec sudo /usr/bin/startx "$@"; fi
if pidof Xfbdev >/dev/null; then echo 'The Felix desktop is already running.' >&2; exit 1; fi
if [ ! -e /dev/fb0 ]; then
    echo 'No framebuffer. Reboot and choose Felix text mode (startx), not Recovery.' >&2
    exit 1
fi
exec /usr/bin/felix-session
