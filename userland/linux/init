#!/bin/sh
# PID 1 in the writable RAM root. No init system or graphical login required.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=/root
mount -t devtmpfs devtmpfs /dev
mkdir -p /proc /sys /dev/pts /run /tmp /root/Documents /root/.felix /mnt/data
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /tmp
hostname felix
mdev -s
ip link set lo up
/usr/bin/felix-ethernet &
# An optional, user-prepared ext4 disk labelled FELIXDATA preserves home.
# Probe actual disks first: passing an absent LABEL to mount makes the kernel
# print a warning on the framebuffer even when mount's stderr is redirected.
data_device=
for candidate in /dev/sd*; do
    [ -b "$candidate" ] || continue
    case $(blkid "$candidate" 2>/dev/null) in
        *'LABEL="FELIXDATA"'*) data_device=$candidate; break ;;
    esac
done
if [ -n "$data_device" ] && mount -t ext4 "$data_device" /mnt/data 2>/tmp/persistence.log; then
    mkdir -p /mnt/data/home/Documents /mnt/data/home/.felix /mnt/data/home/.wmx
    for item in /root/.wmx/*; do
        name=${item##*/}
        [ -e "/mnt/data/home/.wmx/$name" ] || cp -p "$item" "/mnt/data/home/.wmx/$name"
    done
    mount -o bind /mnt/data/home /root
fi
umask 077
mkdir -p /run/felix-wifi/control
/usr/bin/wificonfig --autoconnect >/run/felix-wifi/autoconnect.log 2>&1 &
umask 022
/bin/sh </dev/ttyS0 >/dev/ttyS0 2>&1 &
case " $(cat /proc/cmdline) " in
    *' felix.text=1 '*)
        echo 'Welcome to Felix. Type startx for the desktop; reboot to restart.' >/dev/tty1
        while :; do /bin/sh </dev/tty1 >/dev/tty1 2>&1; done ;;
    *' felix.rescue=1 '*)
        echo 'Felix recovery shell. Run reboot to return to the boot menu.' >/dev/tty1
        while :; do /bin/sh </dev/tty1 >/dev/tty1 2>&1; done ;;
esac
echo 'Felix 1.1: starting desktop' >/dev/console
/usr/bin/felix-session
echo 'Desktop ended. Type startx to return to Felix.' >/dev/tty1
while :; do /bin/sh </dev/tty1 >/dev/tty1 2>&1; done
