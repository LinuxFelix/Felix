+/* Felix NetBSD wscons backend. SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef FELIX_WSFB_H
+#define FELIX_WSFB_H
+#include <stdint.h>
+uint32_t *wsfb_open(unsigned *, unsigned *, unsigned *,
+                    void (*)(uint32_t, int), void (*)(unsigned, int, int));
+void wsfb_poll(void);
+void wsfb_close(void);
+void wsfb_bell(int volume, int pitch, int duration);
+#endif
