diff --git a/kdrive/remote/wsfb.c b/kdrive/remote/wsfb.c
new file mode 100755
index 0000000..949eb12
--- /dev/null
+++ b/kdrive/remote/wsfb.c
@@ -0,0 +1,95 @@
+/* Native NetBSD framebuffer and wscons input for the Felix ISO.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Target: QEMU standard VGA, bootloader VESA 1024x768x32, PC XT keyboard.
+ */
+#include "wsfb.h"
+#include <sys/types.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <dev/wscons/wsconsio.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <stddef.h>
+#include <stdio.h>
+
+static int displayfd=-1, keyboardfd=-1, mousefd=-1;
+static size_t bytes;
+static uint32_t *pixels;
+static unsigned buttons;
+static void (*key_event)(uint32_t,int);
+static void (*mouse_event)(unsigned,int,int);
+
+uint32_t *wsfb_open(unsigned *width,unsigned *height,unsigned *stride,
+                    void (*key)(uint32_t,int),void (*mouse)(unsigned,int,int)) {
+    struct wsdisplay_fbinfo info;
+    unsigned type;
+    int mode=WSDISPLAYIO_MODE_DUMBFB, pitch, version=WSKBDIO_EVENT_VERSION;
+    key_event=key;mouse_event=mouse;
+    displayfd=open("/dev/ttyE0",O_RDWR);
+    if(displayfd<0)goto fail;
+    if(ioctl(displayfd,WSDISPLAYIO_GINFO,&info)<0 || info.depth!=32
+       || info.width>2048 || info.height>2048 || !info.width || !info.height)goto fail;
+    if(ioctl(displayfd,WSDISPLAYIO_LINEBYTES,&pitch)<0 || pitch<(int)info.width*4 || pitch>32768 || pitch%4)goto fail;
+    if(ioctl(displayfd,WSDISPLAYIO_SMODE,&mode)<0)goto fail;
+    bytes=(size_t)pitch*info.height;
+    pixels=mmap(NULL,bytes,PROT_READ|PROT_WRITE,MAP_SHARED,displayfd,0);
+    if(pixels==MAP_FAILED){pixels=NULL;goto fail;}
+    keyboardfd=open("/dev/wskbd0",O_RDWR|O_NONBLOCK);
+    mousefd=open("/dev/wsmouse0",O_RDWR|O_NONBLOCK);
+    if(keyboardfd<0 || mousefd<0)goto fail;
+    if(ioctl(keyboardfd,WSKBDIO_GTYPE,&type)<0 || (type!=WSKBD_TYPE_PC_XT && type!=WSKBD_TYPE_USB))goto fail;
+    if(ioctl(keyboardfd,WSKBDIO_SETVERSION,&version)<0 || ioctl(mousefd,WSMOUSEIO_SETVERSION,&version)<0)goto fail;
+    *width=info.width;*height=info.height;*stride=pitch/4;
+    return pixels;
+fail:
+    perror("Felix wscons initialization");wsfb_close();return NULL;
+}
+static int scan_code(int scan) {
+    if(scan<128)return scan;
+    switch(scan) {
+    case 0x9c:return 28;case 0x9d:return 97;case 0xb5:return 53;
+    case 0xb8:return 100;case 0xc7:return 102;case 0xc8:return 103;
+    case 0xc9:return 104;case 0xcb:return 105;case 0xcd:return 106;
+    case 0xcf:return 107;case 0xd0:return 108;case 0xd1:return 109;
+    case 0xd2:return 110;case 0xd3:return 111;case 0xdb:return 125;
+    case 0xdc:return 126;default:return -1;
+    }
+}
+void wsfb_poll(void) {
+    struct wscons_event events[32];
+    ssize_t n;unsigned i;
+    if(keyboardfd<0 || mousefd<0)return;
+    n=read(keyboardfd,events,sizeof(events));
+    if(n>0)for(i=0;i<(size_t)n/sizeof(events[0]);i++) {
+        int scan=scan_code(events[i].value);
+        if(events[i].type==WSCONS_EVENT_ALL_KEYS_UP)key_event(0xffffffff,0);
+        else if(scan>=0 && (events[i].type==WSCONS_EVENT_KEY_DOWN || events[i].type==WSCONS_EVENT_KEY_UP))
+            key_event(scan,events[i].type==WSCONS_EVENT_KEY_DOWN);
+    }
+    n=read(mousefd,events,sizeof(events));
+    if(n>0)for(i=0;i<(size_t)n/sizeof(events[0]);i++) {
+        int value=events[i].value,dx=0,dy=0;
+        switch(events[i].type) {
+        case WSCONS_EVENT_MOUSE_DOWN:if(value>=0 && value<3)buttons|=1u<<value;break;
+        case WSCONS_EVENT_MOUSE_UP:if(value>=0 && value<3)buttons&=~(1u<<value);break;
+        case WSCONS_EVENT_MOUSE_DELTA_X:dx=value;break;
+        case WSCONS_EVENT_MOUSE_DELTA_Y:dy=-value;break;
+        case WSCONS_EVENT_MOUSE_DELTA_Z:
+            mouse_event(buttons|(value>0?16:8),0,0);mouse_event(buttons,0,0);continue;
+        default:continue;
+        }
+        mouse_event(buttons,dx,dy);
+    }
+}
+void wsfb_bell(int volume,int pitch,int duration) {
+    struct wskbd_bell_data bell={WSKBD_BELL_DOALL,pitch,duration,volume};
+    if(keyboardfd>=0)ioctl(keyboardfd,WSKBDIO_COMPLEXBELL,&bell);
+}
+void wsfb_close(void) {
+    int mode=WSDISPLAYIO_MODE_EMUL;
+    if(keyboardfd>=0)close(keyboardfd);
+    if(mousefd>=0)close(mousefd);
+    if(pixels)munmap(pixels,bytes);
+    if(displayfd>=0){ioctl(displayfd,WSDISPLAYIO_SMODE,&mode);close(displayfd);}
+    keyboardfd=mousefd=displayfd=-1;pixels=NULL;
+}
