diff --git a/kdrive/remote/remote.c b/kdrive/remote/remote.c
new file mode 100755
index 0000000..26bafea
--- /dev/null
+++ b/kdrive/remote/remote.c
@@ -0,0 +1,164 @@
+/* TinyX portable memory framebuffer and RFB input adapter for Felix.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include "kdrive.h"
+#include "kkeymap.h"
+#include "inputstr.h"
+#include "rfb.h"
+#ifdef FELIX_WSCONS
+#include "wsfb.h"
+#endif
+#include <X11/keysym.h>
+#include <signal.h>
+#include <stdlib.h>
+
+static const char *address = "127.0.0.1";
+static unsigned port = 5900;
+static int input_ready;
+static int previous_x, previous_y, have_pointer;
+extern PtrCtrl defaultPointerControl;
+#ifdef FELIX_WSCONS
+static const KdOsFuncs remote_os = { .pollEvents = wsfb_poll };
+#else
+static const KdOsFuncs remote_os = { .pollEvents = rfb_poll };
+#endif
+/* Required by the X server OS layer; no device/VT privileges are needed. */
+void OsVendorInit(void) {}
+
+static void keyboard_load(void) {
+    const char *row1 = "1234567890-=", *upper1 = "!@#$%^&*()_+";
+    const char *row2 = "qwertyuiop[]", *upper2 = "QWERTYUIOP{}";
+    const char *row3 = "asdfghjkl;'", *upper3 = "ASDFGHJKL:\"";
+    const char *row4 = "zxcvbnm,./", *upper4 = "ZXCVBNM<>?";
+    int i;
+    static const struct { int scan; KeySym sym; } special[] = {
+        {1,XK_Escape}, {14,XK_BackSpace}, {15,XK_Tab}, {28,XK_Return},
+        {29,XK_Control_L}, {42,XK_Shift_L}, {54,XK_Shift_R}, {56,XK_Alt_L},
+        {57,XK_space}, {58,XK_Caps_Lock}, {97,XK_Control_R}, {100,XK_Alt_R},
+        {102,XK_Home}, {103,XK_Up}, {104,XK_Page_Up}, {105,XK_Left},
+        {106,XK_Right}, {107,XK_End}, {108,XK_Down}, {109,XK_Page_Down},
+        {110,XK_Insert}, {111,XK_Delete}, {125,XK_Super_L}, {126,XK_Super_R}
+    };
+    kdMinScanCode = 0; kdMaxScanCode = 127;
+    memset(kdKeymap, 0, sizeof(kdKeymap));
+#define ROW(start, low, high) for (i = 0; low[i]; i++) { \
+    kdKeymap[((start) + i) * 4] = low[i]; kdKeymap[((start) + i) * 4 + 1] = high[i]; }
+    ROW(2,row1,upper1); ROW(16,row2,upper2);
+    ROW(30,row3,upper3); ROW(44,row4,upper4);
+#undef ROW
+    kdKeymap[41*4] = '`'; kdKeymap[41*4+1] = '~';
+    kdKeymap[43*4] = '\\'; kdKeymap[43*4+1] = '|';
+    for (i = 0; i < sizeof(special)/sizeof(special[0]); i++)
+        kdKeymap[special[i].scan*4] = special[i].sym;
+    for (i = 0; i < 10; i++) kdKeymap[(59+i)*4] = XK_F1+i;
+    kdKeymap[87*4] = XK_F11; kdKeymap[88*4] = XK_F12;
+}
+static void keyboard_event(uint32_t sym, int down) {
+    int scan, col;
+    if (!input_ready) return;
+    if (!sym) { KdReleaseAllKeys(); have_pointer = 0; return; }
+    for (scan = 0; scan <= kdMaxScanCode; scan++) for (col = 0; col < 2; col++)
+        if (kdKeymap[scan*4+col] == sym) {
+            KdEnqueueKeyboardEvent(scan, !down); return;
+        }
+}
+static void pointer_event(unsigned buttons, unsigned x, unsigned y) {
+    if (!input_ready) return;
+    if (have_pointer)
+        KdEnqueueMouseEvent(kdMouseInfo, buttons | KD_MOUSE_DELTA,
+                            (int)x - previous_x, (int)y - previous_y);
+    else KdEnqueueMouseEvent(kdMouseInfo, buttons, x, y);
+    previous_x = x; previous_y = y; have_pointer = 1;
+}
+static Bool mouse_init(void) { return TRUE; }
+static void noop(void) {}
+static int keyboard_init(void) { return 0; }
+static void leds(int mask) { (void)mask; }
+static void bell(int volume, int frequency, int duration) {
+#ifdef FELIX_WSCONS
+    wsfb_bell(volume, frequency, duration);
+#endif
+}
+static const KdMouseFuncs mouse_funcs = { mouse_init, noop };
+static const KdKeyboardFuncs keyboard_funcs = { keyboard_load, keyboard_init, leds, bell, noop, 0 };
+#ifdef FELIX_WSCONS
+static void wscons_key(uint32_t scan, int down) {
+    if (!input_ready) return;
+    if (scan == 0xffffffff) KdReleaseAllKeys();
+    else KdEnqueueKeyboardEvent(scan, !down);
+}
+static void wscons_pointer(unsigned buttons, int dx, int dy) {
+    if (input_ready) KdEnqueueMouseEvent(kdMouseInfo, buttons | KD_MOUSE_DELTA, dx, dy);
+}
+#endif
+static Bool card_init(KdCardInfo *card) {
+    card->driver = card; KdOsInit(&remote_os); return TRUE;
+}
+static Bool screen_init(KdScreenInfo *s) {
+    if (!s->width) s->width = 1024;
+    if (!s->height) s->height = 768;
+    if (s->width < 64 || s->height < 64 || s->width > 2048 || s->height > 2048
+        || s->randr != RR_Rotate_0) return FALSE;
+    s->fb.depth = 24; s->fb.bitsPerPixel = 32;
+    s->fb.pixelStride = s->width; s->fb.byteStride = s->width * 4;
+    s->fb.redMask = 0xff0000; s->fb.greenMask = 0x00ff00; s->fb.blueMask = 0x0000ff;
+    s->fb.visuals = (1 << TrueColor); s->fb.shadow = FALSE;
+    s->dumb = TRUE; s->softCursor = TRUE;
+#ifdef FELIX_WSCONS
+    { unsigned w,h,stride;
+      s->fb.frameBuffer = (CARD8 *)wsfb_open(&w,&h,&stride,wscons_key,wscons_pointer);
+      if(!s->fb.frameBuffer)return FALSE;
+      s->width=w;s->height=h;s->fb.pixelStride=stride;s->fb.byteStride=stride*4;
+    }
+#else
+    s->fb.frameBuffer = calloc(s->height, s->fb.byteStride);
+    if (!s->fb.frameBuffer) return FALSE;
+    signal(SIGPIPE, SIG_IGN);
+    if (rfb_open(address, port, s->width, s->height,
+                 (uint32_t *)s->fb.frameBuffer, keyboard_event, pointer_event)) {
+        free(s->fb.frameBuffer); s->fb.frameBuffer = NULL; return FALSE;
+    }
+    ErrorF("Felix TinyX: RFB listening on %s:%u\n", address, port);
+#endif
+    return TRUE;
+}
+static void screen_fini(KdScreenInfo *s) {
+#ifdef FELIX_WSCONS
+    wsfb_close(); input_ready=0; s->fb.frameBuffer=NULL;
+#else
+    rfb_close(); input_ready = 0; free(s->fb.frameBuffer); s->fb.frameBuffer = NULL;
+#endif
+}
+static const KdCardFuncs remote_card = {
+    .cardinit = card_init, .scrinit = screen_init, .scrfini = screen_fini
+};
+void InitCard(char *name) {
+    if (kdCardInfo) FatalError("Xtinyremote supports one screen only\n");
+    KdCardInfoAdd(&remote_card, 0);
+}
+void InitOutput(ScreenInfo *info, int argc, char **argv) { KdInitOutput(info, argc, argv); }
+void InitInput(int argc, char **argv) {
+    defaultPointerControl.num = 1;
+    defaultPointerControl.den = 1;
+    defaultPointerControl.threshold = 0;
+    if (!kdMouseInfo) KdParseMouse("remote,5");
+    kdMouseInfo->emulateMiddleButton = FALSE;
+    kdMouseInfo->transformCoordinates = FALSE;
+    KdInitInput(&mouse_funcs, &keyboard_funcs); input_ready = 1;
+}
+void ddxUseMsg(void) {
+    KdUseMsg(); ErrorF("-rfbaddress IPv4  (default 127.0.0.1)\n-rfbport port     (default 5900)\n");
+}
+int ddxProcessArgument(int argc, char **argv, int i) {
+    if (!strcmp(argv[i], "-version")) { kdVersion("Xtinyremote"); exit(0); }
+    if (!strcmp(argv[i], "-rfbaddress") && i+1 < argc) { address = argv[i+1]; return 2; }
+    if (!strcmp(argv[i], "-rfbport") && i+1 < argc) {
+        char *end; unsigned long n = strtoul(argv[i+1], &end, 10);
+        if (*end || !n || n > 65535) FatalError("Invalid RFB port\n");
+        port = n; return 2;
+    }
+    return KdProcessArgument(argc, argv, i);
+}
diff --git a/kdrive/remote/rfb.c b/kdrive/remote/rfb.c
new file mode 100755
index 0000000..ae7bf7a
--- /dev/null
+++ b/kdrive/remote/rfb.c
@@ -0,0 +1,207 @@
+/* Felix RFB 3.3/3.7/3.8 server; raw true-color encoding, one viewer.
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * All sockets are nonblocking. A slow/malformed viewer cannot block X.
+ * This deliberately has no authentication: bind to loopback, or use an
+ * isolated guest network with a loopback-only host port forward.
+ */
+#include "rfb.h"
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int listener = -1, client = -1, phase, version;
+static unsigned width, height, bpp, big, redmax, greenmax, bluemax;
+static unsigned redshift, greenshift, blueshift;
+static uint32_t *framebuffer;
+static void (*on_key)(uint32_t, int);
+static void (*on_pointer)(unsigned, unsigned, unsigned);
+static unsigned char input[65536], *output;
+static size_t used, outlen, sent, capacity;
+static int requested;
+static unsigned rx, ry, rw, rh;
+
+static unsigned get16(const unsigned char *p) { return (p[0] << 8) | p[1]; }
+static uint32_t get32(const unsigned char *p) {
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | (p[2] << 8) | p[3];
+}
+static void put16(unsigned char *p, unsigned n) { p[0] = n >> 8; p[1] = n; }
+static void put32(unsigned char *p, uint32_t n) {
+    p[0] = n >> 24; p[1] = n >> 16; p[2] = n >> 8; p[3] = n;
+}
+static void disconnect(void) {
+    if (client >= 0) close(client);
+    client = -1; used = outlen = sent = 0; requested = 0;
+    /* Adapter releases all held keys and mouse buttons on disconnect. */
+    if (on_key) on_key(0, 0);
+    if (on_pointer) on_pointer(0, 0, 0);
+}
+static int nonblock(int fd) {
+    int flags = fcntl(fd, F_GETFL);
+    return flags < 0 ? -1 : fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+}
+static int queue(const void *data, size_t length) {
+    if (length > capacity - outlen) { disconnect(); return 0; }
+    memcpy(output + outlen, data, length); outlen += length; return 1;
+}
+static void flush(void) {
+    while (client >= 0 && sent < outlen) {
+        ssize_t n = send(client, output + sent, outlen - sent, 0);
+        if (n > 0) sent += (size_t)n;
+        else if (n < 0 && errno == EINTR) continue;
+        else if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+        else { disconnect(); return; }
+    }
+    if (sent == outlen) sent = outlen = 0;
+}
+static void server_init(void) {
+    unsigned char packet[29] = {0};
+    put16(packet, width); put16(packet + 2, height);
+    packet[4] = 32; packet[5] = 24; packet[7] = 1;
+    put16(packet + 8, 255); put16(packet + 10, 255); put16(packet + 12, 255);
+    packet[14] = 16; packet[15] = 8;
+    put32(packet + 20, 5); memcpy(packet + 24, "Felix", 5);
+    queue(packet, sizeof(packet));
+    bpp = 32; big = 0; redmax = greenmax = bluemax = 255;
+    redshift = 16; greenshift = 8; blueshift = 0;
+}
+static int valid_channel(unsigned max, unsigned shift) {
+    unsigned bits = 0, n = max;
+    if (!n || (n & (n + 1))) return 0;
+    while (n) { bits++; n >>= 1; }
+    return shift < bpp && bits + shift <= bpp;
+}
+static void frame(void) {
+    unsigned char header[16] = {0};
+    unsigned x, y, k, bytes = bpp / 8;
+    if (outlen || !requested) return;
+    requested = 0;
+    put16(header + 2, 1); put16(header + 4, rx); put16(header + 6, ry);
+    put16(header + 8, rw); put16(header + 10, rh);
+    queue(header, sizeof(header));
+    for (y = ry; y < ry + rh; y++) for (x = rx; x < rx + rw; x++) {
+        uint32_t p = framebuffer[y * width + x];
+        uint32_t v = ((((p >> 16) & 255) * redmax / 255) << redshift)
+                   | ((((p >> 8) & 255) * greenmax / 255) << greenshift)
+                   | (((p & 255) * bluemax / 255) << blueshift);
+        for (k = 0; k < bytes; k++)
+            output[outlen++] = v >> (8 * (big ? bytes - 1 - k : k));
+    }
+}
+static void parse(void) {
+    while (client >= 0 && used) {
+        size_t length;
+        if (phase == 0) {
+            if (used < 12) return;
+            if (!memcmp(input, "RFB 003.003\n", 12)) version = 3;
+            else if (!memcmp(input, "RFB 003.007\n", 12)) version = 7;
+            else if (!memcmp(input, "RFB 003.008\n", 12)) version = 8;
+            else { disconnect(); return; }
+            if (version == 3) { const unsigned char sec[] = {0,0,0,1}; queue(sec, 4); phase = 2; }
+            else { const unsigned char sec[] = {1,1}; queue(sec, 2); phase = 1; }
+            length = 12;
+        } else if (phase == 1) {
+            if (input[0] != 1) { disconnect(); return; }
+            if (version == 8) { const unsigned char ok[] = {0,0,0,0}; queue(ok, 4); }
+            length = 1; phase = 2;
+        } else if (phase == 2) {
+            length = 1; phase = 3; server_init();
+        } else {
+            switch (input[0]) {
+            case 0: /* SetPixelFormat */
+                length = 20; if (used < length) return;
+                bpp = input[4]; big = input[6];
+                redmax = get16(input + 8); greenmax = get16(input + 10); bluemax = get16(input + 12);
+                redshift = input[14]; greenshift = input[15]; blueshift = input[16];
+                if ((bpp != 8 && bpp != 16 && bpp != 32) || big > 1 || input[7] != 1
+                    || !valid_channel(redmax, redshift) || !valid_channel(greenmax, greenshift)
+                    || !valid_channel(bluemax, blueshift)
+                    || (((uint32_t)redmax << redshift) & ((uint32_t)greenmax << greenshift))
+                    || (((uint32_t)redmax << redshift) & ((uint32_t)bluemax << blueshift))
+                    || (((uint32_t)greenmax << greenshift) & ((uint32_t)bluemax << blueshift))) {
+                    disconnect(); return;
+                }
+                break;
+            case 2: /* SetEncodings: raw is mandatory in RFB. */
+                if (used < 4) return;
+                length = 4 + (size_t)get16(input + 2) * 4; break;
+            case 3: /* FramebufferUpdateRequest */
+                length = 10; if (used < length) return;
+                rx = get16(input + 2); ry = get16(input + 4);
+                rw = get16(input + 6); rh = get16(input + 8);
+                if (rx >= width || ry >= height || !rw || !rh) { disconnect(); return; }
+                if (rw > width - rx) rw = width - rx;
+                if (rh > height - ry) rh = height - ry;
+                requested = 1; break;
+            case 4: /* KeyEvent */
+                length = 8; if (used < length) return;
+                if (on_key) on_key(get32(input + 4), input[1] != 0); break;
+            case 5: /* PointerEvent */
+                length = 6; if (used < length) return;
+                { unsigned x = get16(input + 2), y = get16(input + 4);
+                  if (on_pointer) on_pointer(input[1] & 31,
+                      x < width ? x : width - 1, y < height ? y : height - 1); }
+                break;
+            case 6: /* Clipboard is deliberately ignored, with bounded storage. */
+                if (used < 8) return;
+                if (get32(input + 4) > sizeof(input) - 8) { disconnect(); return; }
+                length = 8 + get32(input + 4); break;
+            default: disconnect(); return;
+            }
+        }
+        if (length > sizeof(input)) { disconnect(); return; }
+        if (used < length) return;
+        if (client < 0) return;
+        used -= length; memmove(input, input + length, used);
+    }
+}
+int rfb_open(const char *address, unsigned port, unsigned w, unsigned h,
+             uint32_t *pixels, void (*key)(uint32_t, int),
+             void (*pointer)(unsigned, unsigned, unsigned)) {
+    struct sockaddr_in addr;
+    int one = 1;
+    if (!w || !h || w > 2048 || h > 2048 || !port || port > 65535) return -1;
+    memset(&addr, 0, sizeof(addr)); addr.sin_family = AF_INET; addr.sin_port = htons(port);
+    if (inet_pton(AF_INET, address, &addr.sin_addr) != 1) return -1;
+    width = w; height = h; framebuffer = pixels; on_key = key; on_pointer = pointer;
+    capacity = (size_t)w * h * 4 + 4096;
+    output = malloc(capacity); if (!output) return -1;
+    listener = socket(AF_INET, SOCK_STREAM, 0);
+    if (listener < 0) { rfb_close(); return -1; }
+    setsockopt(listener, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+    if (nonblock(listener) || bind(listener, (struct sockaddr *)&addr, sizeof(addr)) || listen(listener, 1)) {
+        rfb_close(); return -1;
+    }
+    return 0;
+}
+void rfb_poll(void) {
+    if (client < 0) {
+        client = accept(listener, NULL, NULL);
+        if (client < 0) return;
+        if (nonblock(client)) { disconnect(); return; }
+        phase = 0; used = outlen = sent = 0;
+        queue("RFB 003.008\n", 12);
+    }
+    flush();
+    if (client < 0) return;
+    /* Bound per-tick work even if the peer continuously sends messages. */
+    { unsigned budget;
+      for (budget = 0; budget < 8; budget++) {
+        ssize_t n = recv(client, input + used, sizeof(input) - used, 0);
+        if (n > 0) { used += n; parse(); if (client < 0) return; }
+        else if (n < 0 && errno == EINTR) continue;
+        else if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) break;
+        else { disconnect(); return; }
+      }
+    }
+    frame(); flush();
+}
+void rfb_close(void) {
+    disconnect(); if (listener >= 0) close(listener); listener = -1;
+    free(output); output = NULL; capacity = 0;
+}
