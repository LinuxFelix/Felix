+// Closing clients are already gone by DestroyNotify. Animate an independent
+// titlebar proxy so no timeout ever refers to a deleted Frame or client.
+class ClosingTitle : public Fl_Window {
+  int step_=0,origin_y_;
+  static void tick(void *p) {
+    ClosingTitle *c=(ClosingTitle*)p;
+    if(++c->step_>=7){c->hide();Fl::delete_widget(c);return;}
+    c->position(c->x(),c->origin_y_+c->step_*5);
+    Fl::repeat_timeout(.02,tick,c);
+  }
+  void draw() {
+    felix_glass(0,0,w(),h(),false);
+    fl_color(FL_FOREGROUND_COLOR);fl_font(FL_HELVETICA,12);
+    if(label())fl_draw(label(),8,0,w()-16,h(),FL_ALIGN_LEFT|FL_ALIGN_INSIDE);
+  }
+public:
+  ClosingTitle(int x,int y,int w,const char *title):Fl_Window(x,y,w,24),origin_y_(y) {
+    copy_label(title?title:"");set_override();end();show();Fl::add_timeout(.02,tick,this);
+  }
+  ~ClosingTitle(){Fl::remove_timeout(tick,this);}
+};
