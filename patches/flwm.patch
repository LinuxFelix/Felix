@@ -0,0 +1,21 @@
+#ifndef FELIX_GLASS_H
+#define FELIX_GLASS_H
+#include <FL/fl_draw.H>
+// Gentle Aqua-inspired reflection, without textures or a compositor.
+static void felix_glass(int x,int y,int w,int h,bool active,bool pressed=false,bool close=false) {
+  if(w<2 || h<2)return;
+  for(int row=0;row<h;row++) {
+    int t=255*row/(h-1);
+    int reflection=row<h/2?12:0;
+    int r=240-47*t/255+reflection,g=242-32*t/255+reflection,b=243-17*t/255+reflection;
+    if(!active){r=239-20*t/255;g=244-20*t/255;b=248-20*t/255;}
+    if(close){r=250-20*t/255;g=174-81*t/255;b=169-80*t/255;}
+    if(pressed){r=r*4/5;g=g*4/5;b=b*4/5;}
+    fl_color((uchar)r,(uchar)g,(uchar)b);
+    fl_xyline(x,y+row,x+w-1);
+  }
+  fl_color(143,165,185);fl_rect(x,y,w,h);
+  fl_color(active?fl_rgb_color(255,255,255):fl_rgb_color(247,249,251));
+  fl_xyline(x+1,y+1,x+w-2);fl_yxline(x+1,y+1,y+h-2);
+}
+#endif
