+void Frame::slide_tick(void *p) {
+  Frame *f=(Frame*)p;
+  if(++f->slide_step_>=6 || Fl::pushed() || f->state_!=NORMAL) {
+    XMoveWindow(fl_display,fl_xid(f),f->x(),f->y());return;
